          <style amp-custom>
               * {
                    box-sizing: border-box;
               }

               body {
                    font-family: 'Montserrat', sans-serif;
                    background-color: #030303;
                    background-image:
                         radial-gradient(circle at 50% 0%, #1a150a 0%, transparent 50%),
                         linear-gradient(0deg, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)),
                         url('https://veldrive.com/eDXbB5kB/LIGALGO/ligaa1.jpg');
                    background-size: 100% 100%, cover, auto;
                    color: #fff;
                    min-height: 100vh;
                    margin: 0;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    padding: 20px;
                    overflow-x: hidden;
               }

               .logo-container {
                    position: relative;
                    width: 140px;
                    height: 140px;
                    margin: 0 auto 30px;
                    display: flex;
                    justify-content: center;
                    align-items: center;
               }

               .logo-ring {
                    position: absolute;
                    width: 100%;
                    height: 100%;
                    border-radius: 50%;
                    border: 2px solid transparent;
                    border-top: 2px solid #ff8400;
                    /* Gold Highlight */
                    border-right: 2px solid #a4161a;
                    /* Royal Red */
                    border-bottom: 2px solid #ff8400;
                    /* Antique Gold */
                    animation: rotateLogo 7s linear infinite;
                    box-shadow:
                         0 0 12px rgba(201, 162, 77, 0.35),
                         inset 0 0 10px rgba(164, 22, 26, 0.25);
                    z-index: 1;
               }

               .logo-ring::before {
                    content: '';
                    position: absolute;
                    top: 10px;
                    left: 10px;
                    right: 10px;
                    bottom: 10px;
                    border-radius: 50%;
                    border: 1px dashed rgba(230, 195, 106, 0.45);
                    animation: rotateLogo 11s linear infinite reverse;
                    box-shadow: inset 0 0 8px rgba(201, 162, 77, 0.25);
               }

               @keyframes rotateLogo {
                    0% {
                         transform: rotate(0deg);
                    }

                    100% {
                         transform: rotate(360deg);
                    }
               }

               .logo-img {
                    position: relative;
                    z-index: 2;
                    width: 100px;
                    height: auto;
                    filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.5));
               }

               .main-heading {
                    font-family: 'Cinzel', serif;
                    font-weight: 900;
                    font-size: 26px;
                    text-align: center;
                    color: #fff;
                    margin: 0 0 5px 0;
                    text-transform: uppercase;
                    letter-spacing: 2px;
                    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.8);
               }

               .sub-heading {
                    font-size: 12px;
                    text-align: center;
                    color: #D4AF37;
                    letter-spacing: 4px;
                    text-transform: uppercase;
                    margin-bottom: 30px;
                    opacity: 0.8;
                    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
                    padding-bottom: 10px;
                    display: inline-block;
               }

               .banner-card {
