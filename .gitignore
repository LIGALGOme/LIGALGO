                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background: radial-gradient(circle, rgba(164, 22, 26, 0.25), rgba(0, 0, 0, 0.6));
                    border-radius: 50%;
                    border: 1px solid rgba(201, 162, 77, 0.45);
                    box-shadow: inset 0 0 6px rgba(201, 162, 77, 0.25);
               }

               .icon-box amp-img {
