                    filter: drop-shadow(0 0 4px rgba(201, 162, 77, 0.6));
               }

               .action-link {
                    text-decoration: none;
                    padding: 12px 25px;
                    border-radius: 8px;
                    font-weight: 700;
                    font-size: 12px;
                    text-transform: uppercase;
                    letter-spacing: 1.2px;
                    transition: all 0.3s ease;
                    margin-right: 5px;
                    position: relative;
                    z-index: 2;
               }

               .btn-outline {
